#!/usr/bin/env bash
# FuzzyPaste: copy long text you paste often (prompts, commands, replies) to the clipboard.
set -euo pipefail

# Set when a release is tagged; the installer reads this line
FZP_VERSION="0.1.0"

FZP_LIB="$(dirname "$(realpath "$0")")/../lib/fzp"
# How fzf calls back into this script (tabs, list reloads, preview)
FZP_SELF="$(printf '%q' "$(realpath "$0")")"

source "$FZP_LIB/common.sh"
source "$FZP_LIB/clipboard.sh"
source "$FZP_LIB/pick.sh"
source "$FZP_LIB/add.sh"
source "$FZP_LIB/config.sh"
source "$FZP_LIB/uninstall.sh"

# The commands, then where the config file and the templates are
usage() {
  local config_state=""
  [[ -f "$config_file" ]] || config_state=" (not created yet)"
  cat <<EOF
FuzzyPaste: copy long text you paste often (prompts, commands, replies) to the clipboard.

  fzp              pick a template and copy it
  fzp add          save a new template into a category
  fzp config       show the settings, change the templates folder
  fzp uninstall    remove fzp
  fzp help         show this help (also -h, --help)
  fzp --version    show the version (also -V)

Config file:      $(shorten_home "$config_file")$config_state
Templates folder: $(shorten_home "$templates_dir") ($(plural "$(count_templates "$templates_dir")" template))
EOF
}

load_config
# Not while fzf calls back into fzp, where it would land in the middle of the screen
[[ "${1:-}" == _* ]] || warn_config

# The fzf the installer downloaded when the system's was missing or too old, else the system's
fzp_fzf=fzf
for f in "$FZP_LIB/fzf" "$install_lib/fzf"; do
  [[ -x "$f" ]] && { fzp_fzf="$f"; break; }
done
case "${1:-}" in
  "" | add)
    command -v "$fzp_fzf" >/dev/null ||
      { echo "fzp: fzf isn't installed. Run the fzp installer again: it can set one up." >&2; exit 1; } ;;
esac

case "${1:-}" in
  "") pick_main ;;
  add) add_main ;;
  config) config_main ;;
  uninstall) uninstall_main ;;
  -h | --help | help) usage ;;
  -V | --version) echo "fzp $FZP_VERSION" ;;
  # Called back by fzf while the picker is open
  _list) enter_templates_dir; list ;;
  _tabs) enter_templates_dir; tabs ;;
  _cycle) enter_templates_dir; cycle "$2" ;;
  _preview) render_preview "$2" "${3:-}" ;;
  *) usage >&2; exit 1 ;;
esac
